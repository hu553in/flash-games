{
  "name": "flash-games",
  "private": true,
  "version": "0.1.0",
  "description": "Flash game player powered by Ruffle with full Progressive Web App (PWA) support. It runs .swf games in a browser and can be installed as an offline-capable app.",
  "author": "hu553in",
  "scripts": {
    "playwright:install": "pnpm playwright install chromium",
    "verify:offline": "pnpm playwright:install && node scripts/verify-offline.js",
    "check": "lefthook run check --all-files --force",
    "check:fix": "lefthook run check-fix --all-files --force",
    "prepare": "command -v lefthook && lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.5",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2"
  }
}
