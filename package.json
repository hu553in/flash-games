{
  "name": "flash-games",
  "version": "0.1.0",
  "private": true,
  "description": "Static browser player for .swf games powered by self-hosted Ruffle.",
  "homepage": "https://flash-games-hu553in.vercel.app",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/flash-games",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && python3 -m http.server 5173 --directory dist",
    "lint": "ultracite check && stylelint --max-warnings 0 --ignore-path .gitignore 'styles/**/*.css'",
    "lint:fix": "ultracite fix && stylelint --max-warnings 0 --fix --ignore-path .gitignore 'styles/**/*.css'",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx --minimum-release-age 259200 github-actionlint",
    "check:types": "bun check && bun check -p tsconfig.worker.json",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check:offline": "bun playwright:install && bun test:offline",
    "check:all": "bun lint && bun check:hooks && bun check:workflows && bun check:types && bun check:unused && bun check:vulns && bun check:offline",
    "check:fix": "bun lint:fix && bun check:all",
    "test:offline": "playwright test",
    "playwright:install": "playwright install --only-shell chromium",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.8.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.3.1",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  },
  "packageManager": "bun@1.4.5"
}
