{
  "name": "flash-games",
  "version": "0.1.0",
  "private": true,
  "description": "Static browser player for .swf games powered by self-hosted Ruffle.",
  "homepage": "https://flash-games-hu553in.vercel.app",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/flash-games",
  "type": "module",
  "scripts": {
    "lint": "ultracite check && stylelint --max-warnings 0 --ignore-path .gitignore 'styles/**/*.css'",
    "lint:fix": "ultracite fix && stylelint --max-warnings 0 --fix --ignore-path .gitignore 'styles/**/*.css'",
    "check:workflows": "bunx github-actionlint",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check:offline": "bun playwright:install && bun run test:offline",
    "check": "bun lint && bun check:workflows && bun check:unused && bun check:vulns && bun check:offline",
    "check:fix": "bun lint:fix && bun check",
    "test:offline": "playwright test",
    "playwright:install": "playwright install chromium",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ultracite": "^7.9.4"
  },
  "packageManager": "bun@1.3.14"
}
