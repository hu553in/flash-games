{
  "name": "flash-games",
  "version": "0.1.0",
  "private": true,
  "description": "Static browser player for .swf games powered by self-hosted Ruffle.",
  "homepage": "https://flash-games-hu553in.vercel.app",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/flash-games",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && python3 -m http.server 5173 --directory dist",
    "lint": "ultracite check && stylelint --max-warnings 0 --ignore-path .gitignore 'styles/**/*.css'",
    "lint:fix": "ultracite fix && stylelint --max-warnings 0 --fix --ignore-path .gitignore 'styles/**/*.css'",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx github-actionlint",
    "check:renovate": "bunx --package renovate renovate-config-validator --strict --no-global renovate.json",
    "check:unused": "knip",
    "check:types": "tsc --pretty && tsc --pretty -p tsconfig.worker.json",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check:offline": "bun playwright:install && bun test:offline",
    "check": "bun lint && bun check:hooks && bun check:workflows && bun check:renovate && bun check:types && bun check:unused && bun check:vulns && bun check:offline",
    "check:fix": "bun lint:fix && bun check",
    "test:offline": "playwright test",
    "playwright:install": "playwright install --only-shell chromium",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.6.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0",
    "workbox-build": "^7.4.1"
  },
  "packageManager": "bun@1.4.0"
}
